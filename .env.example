# Environment Configuration

# Azure OpenAI (required for planner/recovery agents)
AZURE_API_KEY=your_azure_api_key
AZURE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_DEPLOYMENT=gpt-4
AZURE_API_VERSION=2024-02-01

# Optional: OpenAI (backwards compatibility)
OPENAI_API_KEY=your_openai_api_key_here

# Browser Settings
HEADLESS=true
BROWSER_TIMEOUT=90000

# UI: Execution timeout (seconds) - request timeout for /execute. Keep high so long tests return response/script.
# EXECUTE_TIMEOUT=7200

# Execution Settings
MAX_RETRIES=3
SCORE_THRESHOLD=0.65
RETRY_DELAY=1.0

# State Management
ENABLE_STATE_TRACKING=true
MAX_STATE_HISTORY=100

# Memory Settings
ENABLE_MEMORY=true
MEMORY_THRESHOLD=0.75

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/automation.log

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
